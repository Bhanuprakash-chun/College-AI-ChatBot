# ---------------------------------------------------------------------------
# College AI Assistant - backend configuration
# Copy to .env and edit. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=College AI Assistant
ENVIRONMENT=development
DEBUG=false

# --- Security ---
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Database (MySQL primary, SQLite fallback) ---
# Either set DATABASE_URL directly...
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/college_ai?charset=utf8mb4
# ...or leave it blank and configure the parts below.
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=college_ai
# If MySQL is unreachable at startup, fall back to SQLite instead of crashing.
DB_ALLOW_SQLITE_FALLBACK=true

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- RAG: chunking (values are in CHARACTERS, see README) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- RAG: retrieval ---
TOP_K=5
SIMILARITY_THRESHOLD=0.30

# --- RAG: models ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_MODEL=llama3.2:3b
# Use 127.0.0.1 rather than localhost (avoids an IPv6 lookup stall on Windows).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1

# --- Storage ---
CHROMA_PATH=../chroma_db
DOCUMENTS_DIR=../documents
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf

# --- Conversation ---
MAX_HISTORY_TURNS=6

# --- Rate limiting ("requests/seconds") ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_REGISTER=5/300
RATE_LIMIT_CHAT=30/60
RATE_LIMIT_UPLOAD=20/300

# --- Bootstrap admin (created on first startup only) ---
# Leave the password blank to have one generated and printed to the log once.
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=College Administrator

# Keep the model resident; a cold 3B model load can take over a minute.
OLLAMA_KEEP_ALIVE=30m
# Pre-load the embedding model and LLM in the background at startup.
WARMUP_ON_STARTUP=true
