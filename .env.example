# Docker Compose settings. Copy to .env and fill in every "change-me".
# Generate strong values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Optional. Leave blank to have a random admin password printed once in the backend log:
#   docker compose logs backend | grep -A3 "BOOTSTRAP ADMIN"
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=

FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080
OLLAMA_MODEL=llama3.2:3b
