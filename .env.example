# ===========================================================================
# College AI Assistant – Unified Environment Configuration
# Copy this file to .env and edit. NEVER commit real secret keys.
# This single .env file is used across local dev, Docker, and Render.
# ===========================================================================

# --- Application ---
APP_NAME=College AI Assistant
ENVIRONMENT=development
DEBUG=false

# --- Security ---
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_INSECURE_DEV_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Database (Postgres / MySQL / SQLite fallback) ---
# Either set DATABASE_URL directly (e.g., Render PostgreSQL, MySQL)...
# DATABASE_URL=postgresql://user:password@localhost:5432/college_ai
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/college_ai?charset=utf8mb4
# ...or leave DATABASE_URL blank to use the MYSQL_* variables below.
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=college_ai
# If external DB is unreachable or not configured, fall back to SQLite automatically.
DB_ALLOW_SQLITE_FALLBACK=true

# --- CORS (comma-separated; leave blank for single-server / same-origin) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- LLM Provider ---
# Use "gemini" for hosted Google Gemini API (recommended for Render & cloud).
# Use "ollama" for local development with an Ollama instance.
LLM_PROVIDER=gemini

# --- Gemini Configuration (when LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama Configuration (when LLM_PROVIDER=ollama) ---
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=30m

# --- RAG: Chunking & Retrieval ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.30
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage ---
# In Docker, these default to /data/chroma_db and /data/documents.
# In local development, these default to ./chroma_db and ./documents at repo root.
CHROMA_PATH=
DOCUMENTS_DIR=
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf

# --- Conversation & Pre-warming ---
MAX_HISTORY_TURNS=6
WARMUP_ON_STARTUP=true

# --- Rate Limiting ("requests/seconds") ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_REGISTER=5/300
RATE_LIMIT_CHAT=30/60
RATE_LIMIT_UPLOAD=20/300

# --- Bootstrap Admin (created on first startup only) ---
# Leave password blank to generate a secure random password printed to the server log once.
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=College Administrator

# --- Frontend Dev Proxy Override (Optional) ---
# Backend URL the Vite dev server proxies /api to during standalone frontend dev.
VITE_BACKEND_URL=http://127.0.0.1:8000
